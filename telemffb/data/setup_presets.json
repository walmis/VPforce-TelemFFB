{
  "version": 1,
  "_comment": [
    "Setup presets for the SetupWizard. Each preset declares:",
    "- requires: minimum device-type list the inventory must have for the",
    "  preset to be offered (positions are not constrained at this level).",
    "- inventory_template: example Device entries the wizard pre-fills if",
    "  the user picks this preset before doing the inventory step. The",
    "  wizard merges these with the user's actual hardware (matched by",
    "  type) — type+positions copy over, USB PIDs come from auto-detect.",
    "- route_overrides: per-effect layer lists that overlay the bundled",
    "  effect_routes_default.json. Empty layers list means: silence on",
    "  all devices."
  ],
  "presets": [
    {
      "name": "Stick + Shaker (Default)",
      "description": "The classic VPForce setup: stick on the desk, bass shaker under the seat. Matches the bundled defaults exactly.",
      "requires": [{"type": "joystick"}, {"type": "shaker"}],
      "inventory_template": [
        {"device_id": "stick_main", "type": "joystick", "positions": ["desk", "center"], "label": "VPForce Stick"},
        {"device_id": "shaker_seat", "type": "shaker", "positions": ["seat", "center"], "label": "Bass Shaker"}
      ],
      "route_overrides": {}
    },
    {
      "name": "Stick only",
      "description": "Just the stick, no shaker. Effects that today route to the shaker are silenced; everything that has a stick layer keeps playing as before.",
      "requires": [{"type": "joystick"}],
      "inventory_template": [
        {"device_id": "stick_main", "type": "joystick", "positions": ["desk", "center"], "label": "VPForce Stick"}
      ],
      "route_overrides": {
        "runway_carrier_delayed": {"layers": []},
        "runway_impulse_delayed": {"layers": []},
        "ab_rumble_1_1":   {"layers": [
          {"target": "type:joystick", "gain": 0.85, "freq_factor": 1.0, "osc_type": "sine"}
        ]},
        "je_rumble_1_1":   {"layers": [
          {"target": "type:joystick", "gain": 0.75, "freq_factor": 1.0, "osc_type": "sine"}
        ]}
      }
    },
    {
      "name": "Helicopter (Stick + Pedals + Collective)",
      "description": "Heli setup with no shaker. Runway/ground feedback to the pedals, gear/touchdown to the collective, rotor on the stick.",
      "requires": [{"type": "joystick"}, {"type": "pedals"}, {"type": "collective"}],
      "inventory_template": [
        {"device_id": "stick_main",       "type": "joystick",   "positions": ["desk", "center"], "label": "VPForce Stick"},
        {"device_id": "pedals_floor",     "type": "pedals",     "positions": ["floor", "front"], "label": "VPForce Pedals"},
        {"device_id": "collective_left",  "type": "collective", "positions": ["left"],            "label": "VPForce Collective"}
      ],
      "route_overrides": {
        "runway_carrier":         {"layers": [
          {"target": "type:pedals",   "gain": 0.6, "freq_factor": 1.5, "osc_type": "sine",
           "direction_policy": "fixed", "direction_value": 270.0}
        ]},
        "runway_carrier_delayed": {"layers": []},
        "runway_impulse":         {"layers": [
          {"target": "type:pedals",   "gain": 0.6, "freq_factor": 1.0, "osc_type": "impulse",
           "direction_policy": "fixed", "direction_value": 270.0}
        ]},
        "runway_impulse_delayed": {"layers": []},
        "touchdown":       {"layers": [
          {"target": "type:collective", "gain": 0.8, "freq_factor": 0.4, "osc_type": "impulse"},
          {"target": "type:pedals",     "gain": 0.5, "freq_factor": 0.4, "osc_type": "impulse"}
        ]},
        "rotor_rpm0-1":    {"layers": [
          {"target": "type:joystick",   "gain": 0.7, "freq_factor": 1.0, "osc_type": "sine"},
          {"target": "type:collective", "gain": 0.4, "freq_factor": 1.0, "osc_type": "sine"}
        ]},
        "gearmovement":    {"layers": [
          {"target": "type:collective", "gain": 0.6, "freq_factor": 0.6, "osc_type": "impulse"}
        ]}
      }
    },
    {
      "name": "Stick + Rudder front + Shaker",
      "description": "Stick on the right, VPForce Rudder up front (e.g. WW2 setup), shaker under the seat. Forward-axis effects (runway, gear) lean on the rudder; per-engine rumbles stay on the stick.",
      "requires": [{"type": "joystick"}, {"type": "rudder"}, {"type": "shaker"}],
      "inventory_template": [
        {"device_id": "stick_main",   "type": "joystick", "positions": ["right", "desk"],  "label": "VPForce Stick"},
        {"device_id": "rudder_front", "type": "rudder",   "positions": ["front", "floor"], "label": "VPForce Rudder"},
        {"device_id": "shaker_seat",  "type": "shaker",   "positions": ["seat", "center"], "label": "Bass Shaker"}
      ],
      "route_overrides": {
        "runway_carrier":         {"layers": [
          {"target": "type:rudder",   "gain": 0.5, "freq_factor": 1.5, "osc_type": "sine",
           "direction_policy": "fixed", "direction_value": 0.0},
          {"target": "type:joystick", "gain": 0.3, "freq_factor": 1.5, "osc_type": "sine"}
        ]},
        "runway_carrier_delayed": {"layers": [
          {"target": "type:shaker", "gain": 0.8, "freq_factor": 0.6, "osc_type": "sine"}
        ]},
        "runway_impulse":         {"layers": [
          {"target": "type:rudder",   "gain": 0.5, "freq_factor": 1.0, "osc_type": "impulse",
           "direction_policy": "fixed", "direction_value": 0.0},
          {"target": "type:joystick", "gain": 0.3, "freq_factor": 1.0, "osc_type": "impulse"}
        ]},
        "runway_impulse_delayed": {"layers": [
          {"target": "type:shaker", "gain": 0.9, "freq_factor": 1.0, "osc_type": "impulse"}
        ]},
        "gearmovement":    {"layers": [
          {"target": "type:shaker",   "gain": 0.7, "freq_factor": 0.6, "osc_type": "impulse"},
          {"target": "type:rudder",   "gain": 0.4, "freq_factor": 1.5, "osc_type": "impulse",
           "direction_policy": "fixed", "direction_value": 0.0}
        ]}
      }
    },
    {
      "name": "Full Setup (Stick + Pedals + Collective + 2x Shaker)",
      "description": "Maximum spatial routing: separate shakers under seat and pedals. Weapons/CM go to seat; gear/runway impulses go to pedal-shaker.",
      "requires": [{"type": "joystick"}, {"type": "pedals"}, {"type": "collective"}, {"type": "shaker"}],
      "inventory_template": [
        {"device_id": "stick_main",       "type": "joystick",   "positions": ["right", "desk"],  "label": "VPForce Stick"},
        {"device_id": "pedals_floor",     "type": "pedals",     "positions": ["floor", "front"], "label": "VPForce Pedals"},
        {"device_id": "collective_left",  "type": "collective", "positions": ["left"],            "label": "VPForce Collective"},
        {"device_id": "shaker_seat",      "type": "shaker",     "positions": ["seat", "center"], "label": "Seat Shaker"},
        {"device_id": "shaker_pedals",    "type": "shaker",     "positions": ["floor", "front"], "label": "Pedal Shaker"}
      ],
      "route_overrides": {
        "gunfire": {"layers": [
          {"target": "id:shaker_seat", "gain": 0.9, "freq_factor": 0.4, "osc_type": "impulse"},
          {"target": "type:joystick",  "gain": 0.5, "freq_factor": 1.0, "osc_type": "sine"}
        ]},
        "cm": {"layers": [
          {"target": "id:shaker_seat", "gain": 0.7, "freq_factor": 0.5, "osc_type": "impulse"},
          {"target": "type:joystick",  "gain": 0.45, "freq_factor": 1.0, "osc_type": "sine"}
        ]},
        "runway_carrier": {"layers": [
          {"target": "type:joystick",    "gain": 0.3, "freq_factor": 1.5, "osc_type": "sine"}
        ]},
        "runway_carrier_delayed": {"layers": [
          {"target": "id:shaker_pedals", "gain": 0.6, "freq_factor": 1.5, "osc_type": "sine"}
        ]},
        "runway_impulse": {"layers": [
          {"target": "type:joystick",    "gain": 0.4, "freq_factor": 1.0, "osc_type": "impulse"}
        ]},
        "runway_impulse_delayed": {"layers": [
          {"target": "id:shaker_pedals", "gain": 0.9, "freq_factor": 1.0, "osc_type": "impulse"}
        ]},
        "gearmovement": {"layers": [
          {"target": "id:shaker_pedals", "gain": 0.7, "freq_factor": 0.6, "osc_type": "impulse"},
          {"target": "type:collective",  "gain": 0.4, "freq_factor": 1.5, "osc_type": "impulse"}
        ]},
        "touchdown_vs_main": {"layers": [
          {"target": "id:shaker_pedals", "gain": 1.0, "freq_factor": 0.4, "osc_type": "impulse"},
          {"target": "type:joystick",    "gain": 0.2, "freq_factor": 1.0, "osc_type": "impulse"}
        ]},
        "touchdown_vs_nose": {"layers": [
          {"target": "id:shaker_pedals", "gain": 0.7, "freq_factor": 0.4, "osc_type": "impulse"},
          {"target": "type:joystick",    "gain": 0.4, "freq_factor": 2.0, "osc_type": "impulse"}
        ]}
      }
    }
  ]
}
